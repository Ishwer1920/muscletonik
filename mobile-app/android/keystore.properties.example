# ---------------------------------------------------------------------------
# RELEASE SIGNING TEMPLATE
# Copy this file to `keystore.properties` (same folder) and fill in YOUR values.
# `keystore.properties` and *.jks/*.keystore are git-ignored — NEVER commit them.
# Losing this keystore means you can never update the app on Play again, so
# back it up somewhere safe (password manager / encrypted drive).
# ---------------------------------------------------------------------------

# Path to your keystore, relative to the mobile-app/android/ folder
# (or an absolute path). Create it with the keytool command in the README.
storeFile=muscle-tonik-release.jks

# The keystore password you chose when running keytool
storePassword=CHANGE_ME

# The key alias you passed to keytool (-alias)
keyAlias=muscletonik

# The key password (often the same as storePassword)
keyPassword=CHANGE_ME

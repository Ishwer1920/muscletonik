<?xml version="1.0" encoding="utf-8"?>
<!-- Keep auth cookies / WebView session storage out of cloud backups and
     device-to-device transfers so a logged-in session can't be copied. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>

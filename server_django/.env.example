NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/muscle_tonik
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CLIENT_ORIGIN=http://localhost:4000

# Other browser origins allowed to call the API with cookies, comma separated.
# The www/apex twin of CLIENT_ORIGIN is added automatically - this is only for
# anything beyond that (a staging host, an app domain, etc).
EXTRA_CORS_ORIGINS=

# How long a signed-in session lasts. The access token was 15 minutes, which is
# what made the admin panel appear to log itself out; 720 = 12 hours.
ACCESS_TOKEN_TTL_MINUTES=720
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_ROTATION_GRACE_SECONDS=120

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Muscle Tonik <no-reply@muscletonik.local>

# SMS gateway for the forgot-password OTP. Leave SMS_PROVIDER blank to disable
# the SMS option entirely (customers then see only the email option); use
# "console" in development to print the code to the log instead of sending it.
# Supported: msg91 | fast2sms | twilio | console
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=MSCTNK
SMS_TEMPLATE_ID=
SMS_COUNTRY_CODE=91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Password reset OTP behaviour.
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS=5
OTP_RESEND_SECONDS=60

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- ClipForge AI backend configuration ----
# Copy this file to ".env" and fill in the keys you have.
# You only need the keys for the features you want to use (see the table).
#
#   Feature              | Needs
#   ---------------------|---------------------------------
#   AI script            | ANTHROPIC_API_KEY
#   Smart highlights     | ANTHROPIC_API_KEY
#   Auto music / mood    | ANTHROPIC_API_KEY
#   Voiceover (TTS)      | OPENAI_API_KEY
#   Auto captions (STT)  | OPENAI_API_KEY

# Anthropic (Claude) — used for scripts, highlight picking, and music mood.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — used for speech-to-text (captions) and text-to-speech (voiceover).
# Anthropic has no audio models, so these two features use OpenAI.
# Get one at https://platform.openai.com/
OPENAI_API_KEY=

# ---- Optional overrides ----
# Claude model for text features (default: claude-opus-5-5)
TEXT_MODEL=claude-opus-5-5
# OpenAI transcription model (default: whisper-1)
STT_MODEL=whisper-1
# OpenAI text-to-speech model (default: tts-1) and voice (default: alloy)
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Port the backend listens on (default: 8787)
PORT=8787
